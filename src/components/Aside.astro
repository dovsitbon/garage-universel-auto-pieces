---
import { site } from '../data/site';
import Status from './Status.astro';
import HoursTable from './HoursTable.astro';
---
<aside class="self-start border-2 border-steel bg-paper p-5 md:p-6" aria-label="Joindre la casse">
  <p class="font-semibold">Plus rapide par téléphone</p>
  <a href={site.phoneHref} class="btn btn-green mono mt-3 w-full">{site.phone}</a>
  <Status class="mt-4 text-[0.95rem] font-semibold" />
  <HoursTable class="mt-4 text-[0.95rem]" />
  <p class="mt-4 text-[0.95rem]">{site.street}, {site.postalCode} {site.city}</p>
  <a href={site.mapsUrl} class="link mt-1 inline-flex min-h-[44px] items-center" target="_blank" rel="noopener">Itinéraire Google Maps</a>
  <p class="mt-3 text-[0.95rem] text-steel">Paiement : {site.payments.toLowerCase()}.</p>
</aside>
