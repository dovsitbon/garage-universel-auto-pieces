---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import { site, hours } from '../data/site';

interface Props {
  title: string;
  description: string;
  extraSchema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, extraSchema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const openDays = hours.filter((h) => h.open).map((h) => `https://schema.org/${dayNames[h.day]}`);

const business: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['AutoPartsStore', 'RecyclingCenter'],
  '@id': `${site.url}/#commerce`,
  name: site.name,
  url: `${site.url}/`,
  telephone: site.phoneIntl,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    postalCode: site.postalCode,
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'FR',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: openDays,
      opens: '09:00',
      closes: '18:00',
    },
  ],
  paymentAccepted: 'Carte bancaire, sans contact',
  areaServed: [site.city, ...site.neighbours].map((name) => ({ '@type': 'City', name })),
  hasMap: site.mapsUrl,
  amenityFeature: [
    {
      '@type': 'LocationFeatureSpecification',
      name: 'Entrée et parking accessibles en fauteuil roulant',
      value: true,
    },
  ],
  identifier: { '@type': 'PropertyValue', propertyID: 'SIREN', value: site.siren.replace(/\s/g, '') },
};
if (site.sameAs.length) business.sameAs = site.sameAs;

const schemas = [business, ...extraSchema];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1f5c3a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-white focus:px-4 focus:py-3"
      >Aller au contenu</a
    >
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <CallBar />
    <script>
      import { initStatus } from '../scripts/status';
      initStatus();
      const items = document.querySelectorAll('.drawer-reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
